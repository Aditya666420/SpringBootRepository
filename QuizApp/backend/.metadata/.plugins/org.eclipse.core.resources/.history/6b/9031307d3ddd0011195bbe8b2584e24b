package com.example.quiz.service;

import com.example.quiz.section.Question;
import com.lowagie.text.*;
import com.lowagie.text.pdf.PdfWriter;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.util.List;

@Service
public class QuizPdfService {

    private static final Font TITLE = new Font(Font.HELVETICA, 18, Font.BOLD);
    private static final Font Q_FONT = new Font(Font.HELVETICA, 12, Font.BOLD);
    private static final Font OPT_FONT = new Font(Font.HELVETICA, 11);
    private static final Font META = new Font(Font.HELVETICA, 10, Font.ITALIC);
    private static final Font ANS_FONT = new Font(Font.HELVETICA, 11, Font.BOLD);

    /** includeAnswers=false gives a blank question paper; true gives the answer key. */
    public byte[] generate(Quiz quiz, boolean includeAnswers) {
        try (ByteArrayOutputStream out = new ByteArrayOutputStream()) {
            Document doc = new Document(PageSize.A4, 50, 50, 50, 50);
            PdfWriter.getInstance(doc, out);
            doc.open();

            doc.add(new Paragraph(quiz.getTitle(), TITLE));
            doc.add(new Paragraph(" "));

            List<Question> questions = quiz.getQuestions();
            for (int i = 0; i < questions.size(); i++) {
                Question q = questions.get(i);

                doc.add(new Paragraph((i + 1) + ". " + q.getText(), Q_FONT));
                if (q.getSection() != null) {
                    doc.add(new Paragraph("Section: " + q.getSection(), META));
                }

                char label = 'A';
                for (String opt : q.getOptions()) {
                    Paragraph p = new Paragraph(label + ") " + opt, OPT_FONT);
                    p.setIndentationLeft(20);
                    doc.add(p);
                    label++;
                }
                doc.add(new Paragraph(" "));
            }

            if (includeAnswers) {
                doc.newPage();
                doc.add(new Paragraph("Answer Key", TITLE));
                doc.add(new Paragraph(" "));

                for (int i = 0; i < questions.size(); i++) {
                    Question q = questions.get(i);
                    char correct = (char) ('A' + q.getCorrectIndex());
                    doc.add(new Paragraph(
                        (i + 1) + ". " + correct + ") " + q.getOptions().get(q.getCorrectIndex()),
                        ANS_FONT));
                    if (q.getExplanation() != null && !q.getExplanation().isBlank()) {
                        Paragraph e = new Paragraph("Explanation: " + q.getExplanation(), META);
                        e.setIndentationLeft(20);
                        doc.add(e);
                    }
                }
            }

            doc.close();
            return out.toByteArray();
        } catch (Exception e) {
            throw new RuntimeException("PDF generation failed", e);
        }
    }
}
