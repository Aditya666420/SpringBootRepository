document.addEventListener("DOMContentLoaded", () => {
	loadDashboard();
	// Dashboard API call
			async function loadDashboard() {

			    const token = localStorage.getItem("JWT");

			    if (!token) {
			        alert("Please login first.");
			        window.location.href = window.loginUrl;
			        return;
			    }


			    try {

			        const response = await fetch(window.dashboardApiUrl, {

			            method: "GET",

			            headers: {
			                "Authorization": "Bearer " + token
			            }

			        });


			        if (!response.ok) {

			            throw new Error("Unable to load dashboard");

			        }


			        const reviews = await response.json();

			        console.log("Dashboard response:", reviews);


			        populateDashboard(reviews);


			    } catch(error) {

			        console.error("Dashboard API error:", error);

			    }

			}


			// Create table rows
			function populateDashboard(reviews) {

			    const tbody = document.getElementById("reviewTableBody");

			    tbody.innerHTML = "";


			    reviews.forEach(review => {

			        tbody.innerHTML += `

			        <tr class="review-row"
			            data-id="${review.id}"
			            style="cursor:pointer;">

			            <td>${review.id}</td>

			            <td>
			                <span class="badge bg-success">
			                    ${review.language}
			                </span>
			            </td>

			            <td class="text-truncate" style="max-width:250px;">
			                ${review.code}
			            </td>

			            <td class="text-truncate" style="max-width:400px;">
			                ${review.reviewResult}
			            </td>

			            <td>
			                ${review.createdAt}
			            </td>

			            <td>
			                <button 
			                    class="btn btn-danger btn-sm delete-btn"
			                    data-id="${review.id}">
			                    Delete
			                </button>
			            </td>

			        </tr>

			        `;

			    });

	}
	// Delete button click
	document.querySelectorAll(".delete-btn")
	.forEach(button => {

	    button.addEventListener("click", function(event) {

	        event.stopPropagation();

	        const id = this.dataset.id;

	        const token = localStorage.getItem("JWT");

	        console.log("Deleting id:", id);
	        console.log("Deleting uri:", window.deleteUrl + "?id=" + id);


	        fetch(window.deleteUrl + "?id=" + id, {

	            method: "DELETE",

	            headers: {
	                "Authorization": "Bearer " + token
	            }

	        })
	        .then(response => {

	            if(response.ok) {

	                return response.text();  // read String response

	            } else {

	                throw new Error("Delete failed");

	            }

	        })
	        .then(message => {

	            console.log("Server response:", message);

	            // Example:
	            // "Review deleted successfully"

	            location.reload();

	        })
	        .catch(error => {

	            console.error("Error:", error);

	        });

	    });

	});
