spring.application.name=APIGATEWAY
server.port=8080

spring.cloud.gateway.routes[1].id=Code-reviewer
spring.cloud.gateway.routes[1].uri=lb://CODE-REVIEWER
spring.cloud.gateway.routes[1].predicates[0]=Path=/api/**

spring.cloud.gateway.routes[0].id=UI-service
spring.cloud.gateway.routes[0].uri=lb://UI-SERVICE
spring.cloud.gateway.routes[0].predicates[0]=Path=/ui/**

spring.cloud.gateway.routes[2].id=Auth-service
spring.cloud.gateway.routes[2].uri=lb://AUTH-SERVICE
spring.cloud.gateway.routes[2].predicates[0]=Path=/auth/**


# Eureka
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/


jwt.secret=ThisIsMyVerySecretKeyForJwtGenerationThatShouldBeAtLeast32CharactersLong

logging.level.org.springframework.cloud.gateway=DEBUG
logging.level.org.springframework.cloud.loadbalancer=DEBUG