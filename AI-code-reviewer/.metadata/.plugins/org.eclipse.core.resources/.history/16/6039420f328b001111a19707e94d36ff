document.addEventListener("DOMContentLoaded", () => {
	
	
			
	const params = new URLSearchParams(window.location.search);
	console.log(window.location.search)

	if (params.get("githubConnected") === "true") {

			   alert("GitHub connected successfully!");
			   // Replace GitHub button with search bar + Get Code button
			           const githubSection = document.getElementById("githubSection");

			           githubSection.innerHTML = `
			               <input
			                   type="text"
			                   id="githubUrl"
			                   class="github-url-input"
			                   placeholder="Paste GitHub file URL">

			               <button
			                   type="button"
			                   id="getGithubCodeBtn"
			                   class="dashboard-btn">
			                   Get Code
			               </button>
			           `;
					   
					   document.getElementById("getGithubCodeBtn")
					   			    .addEventListener("click", async () => {

					   			        const githubUrl = document.getElementById("githubUrl").value;
					   					console.log("Github url :",githubUrl);

					   			        if (!githubUrl) {
					   			            alert("Please enter a GitHub file URL.");
					   			            return;
					   			        }

					   			        const parts = new URL(githubUrl).pathname.split("/");

					   			        const owner = parts[1];
					   			        const repo = parts[2];
					   			        const path = parts.slice(5).join("/");

					   			        try {

					   			            const response = await fetch(
					   			                `http://localhost:8080/github/file?owner=${encodeURIComponent(owner)}&repo=${encodeURIComponent(repo)}&path=${encodeURIComponent(path)}`
					   			            );

					   			            if (!response.ok) {
					   			                throw new Error("Unable to fetch code.");
					   			            }

					   			            const code = await response.text();

					   			            editor.setValue(code);

					   			        } catch (err) {
					   			            console.error(err);
					   			            alert("Failed to fetch code from GitHub.");
					   			        }

					   			    });
					   	

			    // Optional: remove the parameter from the URL
			    window.history.replaceState({}, document.title, window.location.pathname);
		}
		// GitHub button
		    const githubBtn = document.getElementById("githubBtn");

		    githubBtn.addEventListener("click", () => {

		        window.location.href = window.githubLoginUrl;

		    });
			
			

	const dashboardBtn = document.getElementById("dashboardBtn");

	 dashboardBtn.addEventListener("click", async () => {

	     const token = localStorage.getItem("JWT");

	     if (!token) {
	         alert("Please login first.");
	         window.location.href = window.loginUrl;
	         return;
	     }

	     try {

			window.location.href = window.dashboardUrl;

	     } catch (error) {

	         console.error(error);

	         alert("Unable to load dashboard.");

	     }

	 });

});