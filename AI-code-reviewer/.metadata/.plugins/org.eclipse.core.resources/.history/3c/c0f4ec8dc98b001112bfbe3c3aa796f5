<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>

    <title>AI Code Reviewer</title>
	<script th:inline="javascript">
	    window.dashboardUrl = /*[[@{/dashboardPage}]]*/ '';
		window.reviewUrl = /*[[@{/review}]]*/ '';
		window.loginUrl = /*[[@{/login}]]*/ '';
		// Add this
		window.githubLoginUrl = "http://localhost:8080/oauth2/authorization/github";
	</script>
	<script th:src="@{/js/index.js}"></script>
    <link rel="stylesheet" th:href="@{/css/style.css}">

</head>

<body>

<div class="container">

	<div class="header">

	        <h1>AI Code Reviewer</h1>

	        <!-- Place it here -->
	        <div class="header-actions">

	            <div id="githubSection">

	                <button
	                    type="button"
	                    id="githubBtn"
	                    class="dashboard-btn">
	                    Review from GitHub
	                </button>

	            </div>

	            <button
	                type="button"
	                id="dashboardBtn"
	                class="dashboard-btn">
	                Dashboard
	            </button>

	        </div>

	    </div>


    <form id="reviewForm">

        <label>Select Language:</label>

        <select id="language" name = "language">
            <option value="java">Java</option>
            <option value="python">Python</option>
            <option value="javascript">JavaScript</option>
        </select>

        <br><br>

        <div id="editor"></div>

        <input
                type="hidden"
                id="codeInput"
                name="code">

        <button type="submit">
            Review Code
        </button>

    </form>

    <div class="review-box"  th:style="${review != null} ? 'display:block' : 'display:none'">

        <h2>Review Result</h2>

        <pre class="review-content" th:text="${review}"
             >
        </pre>

    </div>
	<div id="errorBox" class="error-box" style="display: none;">

	    <h3>Error</h3>

	    <p id="errorMessage"></p>

	</div>
</div>

<!--<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.52.2/min/vs/loader.min.js"></script>-->

<script th:inline="javascript">

    var previousCode = /*[[${code}]]*/ '';
	window.reviewByIdUrl = /*[[@{/reviewById}]]*/ ''
	console.log("Code"+previousCode);

</script>

<script th:src="@{/js/editor.js}"></script>

</body>
</html>