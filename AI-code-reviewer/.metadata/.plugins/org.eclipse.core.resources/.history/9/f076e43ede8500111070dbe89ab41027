spring.application.name=APIGATEWAY
server.port=8080


spring.cloud.gateway.server.webflux.routes[0].id=ui-service
spring.cloud.gateway.server.webflux.routes[0].uri=lb://UI-SERVICE
spring.cloud.gateway.server.webflux.routes[0].predicates[0]=Path=/

spring.cloud.gateway.server.webflux.routes[1].id=review-service
spring.cloud.gateway.server.webflux.routes[1].uri=lb://AI-CODE-REVIEWER
spring.cloud.gateway.server.webflux.routes[1].predicates[0]=Path=/ai/**

# Eureka
eureka.client.service-url.defaultZone=http://localhost:8761/eureka

# Enable service discovery
spring.cloud.gateway.server.webflux.discovery.locator.enabled=true
spring.cloud.gateway.server.webflux.discovery.locator.lower-case-service-id=true

# These are true by default, but you can specify them explicitly
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true