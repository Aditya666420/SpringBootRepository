<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>

    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" th:href="@{/css/dashboard.css}">
	<script th:inline="javascript">
	    window.deleteUrl = /*[[@{/delete}]]*/ '';
		
		window.indexUrl = /*[[@{/}]]*/ ''
	</script>
	<script th:src="@{/js/dashboard.js}"></script>
	
	

</head>

<body class="bg-dark">

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-white">
            AI Code Reviewer Dashboard
        </h2>

        <a th:href="@{/}" class="btn btn-primary">
            Back to Editor
        </a>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">
            <input
                    type="text"
                    id="search"
                    class="form-control"
                    placeholder="Search Code...">
        </div>

    </div>

    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                Review History
            </h4>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover table-striped align-middle mb-0">

                <thead class="table-dark">

                <tr>

                    <th>ID</th>

                    <th>Language</th>

                    <th>Code</th>

                    <th>Review</th>

                    <th>Date</th>
					
					<th>Action</th>

                </tr>

                </thead>

                <tbody>

                <tr
				   th:each="review : ${reviews}"
				   th:attr="data-id=${review.id},data-url=@{/reviewById}"
				   class="review-row"
				   style="cursor:pointer;">

                    <td th:text="${review.id}"></td>

                    <td>

                        <span class="badge bg-success"
                              th:text="${review.language}">
                        </span>

                    </td>

                    <td class="text-truncate"
                        style="max-width:250px;"
                        th:text="${review.code}">
                    </td>

                    <td class="text-truncate"
                        style="max-width:400px;"
                        th:text="${review.reviewResult}">
                    </td>

                    <td th:text="${review.createdAt}">
                    </td>
					<td>
						<button
						       class="btn btn-danger btn-sm"
						       th:attr="data-id=${review.id}"
						       onclick="deleteReview(this.dataset.id, event)">
						       Delete
						   </button>
					</td>

                </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

    document.getElementById("search")
        .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();

            let rows =
                document.querySelectorAll("tbody tr");

            rows.forEach(row => {

                row.style.display =
                    row.innerText
                        .toLowerCase()
                        .includes(value)
                        ? ""
                        : "none";

            });

        });

</script>

</body>

</html>