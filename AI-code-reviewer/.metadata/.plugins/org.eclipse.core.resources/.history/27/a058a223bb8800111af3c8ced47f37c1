					     if (!token) {
					         alert("Please login first.");
					         window.location.href = window.loginUrl;
					         return;
					     }
					const id = row.dataset.id;
					const url = row.dataset.url;
					const uri = window.reviewByIdUrl+`${url}?id=${id}`;
					console.log("URI :"+uri);
					try{
				           const response = await fetch(window.reviewByIdUrl+,{
							method: "GET",
		
								             headers: {
								                 "Authorization": "Bearer " + token
								             }
		
								         });
						   if(!response.ok){
							throw new Error("Unable to load Review ui by id");
