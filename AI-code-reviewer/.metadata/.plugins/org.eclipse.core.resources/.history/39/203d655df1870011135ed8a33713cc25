let editor;

require.config({
    paths: {
        vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.52.2/min/vs'
    }
});

require(
    ['vs/editor/editor.main'],
    function () {

        editor = monaco.editor.create(
            document.getElementById('editor'),
            {

                value: previousCode || '',

                language: 'java',

                theme: 'vs-dark',

                automaticLayout: true,

                minimap: {
                    enabled: false
                }
            }
        );

        document
            .getElementById('language')
            .addEventListener(
                'change',
                function () {

                    monaco.editor.setModelLanguage(
                        editor.getModel(),
                        this.value
                    );
                }
            );

        document
            .querySelector('form')
            .addEventListener(
                'submit',
                function () {

                    document
                        .getElementById('codeInput')
                        .value =
                        editor.getValue();
                }
            );
    }
);