package com.example.employee.service;

import java.util.List;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpHeaders;
import org.springframework.stereotype.Service;
import org.springframework.web.client.HttpClientErrorException;
import org.springframework.web.client.RestTemplate;

import com.example.employee.dto.DepartmentDto;
import com.example.employee.dto.EmployeeRequestDto;
import com.example.employee.dto.EmployeeResponseDto;
import com.example.employee.entity.Employee;
import com.example.employee.exception.ResourceNotFoundException;
import com.example.employee.repo.EmployeeRepository;
import io.github.resilience4j.circuitbreaker.annotation.CircuitBreaker;
import io.github.resilience4j.timelimiter.annotation.TimeLimiter;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.transaction.Transactional;

@Service
public class EmployeeService {
	
	@Autowired
	private EmployeeRepository repository;
	
	@Autowired
	private RestTemplate restTemplate;
	
	  @Autowired
	  private HttpServletRequest request;
	

    @Transactional
    @CircuitBreaker(name="departmentService", fallbackMethod="departmentFallback1")
    public EmployeeResponseDto saveEmployee(
            EmployeeRequestDto dto) {
    	
    	 String token = request.getHeader("Authorization");

    	 HttpHeaders headers = new HttpHeaders();
    	 headers.set("Authorization", token);

        Employee employee = new Employee();

        employee.setName(dto.getName());
        employee.setDepartmentIds(dto.getDepartmentIds());
        List<DepartmentDto> k = dto.getDepartmentIds().stream().map(departmentID -> 
        { try {
        return restTemplate.getForObject(
                "http://DEPARTMENT-SERVICE/departments/"
                        + departmentID,
                DepartmentDto.class);
        }catch(HttpClientErrorException.NotFound  e) {
        	DepartmentDto d1 = new DepartmentDto();
        	d1.setId(departmentID);
        	d1.setName("Unvailable");
        	return d1;
        }
        }).collect(Collectors.toList());
        

        Employee saved =
                repository.save(employee);
        

        
        EmployeeResponseDto resp=	map(saved);
        resp.setDepartments(k);
        return resp;
    }
    public List<DepartmentDto> departmentFallback1(
            List<Long> departmentIds,
            Exception ex) {

        return departmentIds.stream()
                .map(id -> {
                    DepartmentDto dto = new DepartmentDto();
                    dto.setId(id);
                    dto.setName("Department Service Unavailable");
                    return dto;
                })
                .toList();
    }
    @CircuitBreaker(
            name = "departmentService",
            fallbackMethod = "departmentFallback")
    public EmployeeResponseDto getEmployeeById(
            Long id) {

        Employee employee =
