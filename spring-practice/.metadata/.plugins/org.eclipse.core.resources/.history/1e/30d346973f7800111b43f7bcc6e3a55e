                                new ResourceNotFoundException(
                                        "Employee not found"));
        
        List<DepartmentDto> k = employee.getDepartmentIds().stream().map(departmentID -> 
        { try {
        return restTemplate.getForObject(
                "http://DEPARTMENT-SERVICE/departments/"
                        + departmentID,
                DepartmentDto.class);
        }catch(HttpClientErrorException.NotFound  e) {
        	DepartmentDto d1 = new DepartmentDto();
        	d1.setId(departmentID);
        	d1.setName("Unvailable");
        	return d1;
        }
        }).collect(Collectors.toList());
        EmployeeResponseDto response = map(employee);
        response.setDepartments(k);
        

//        EmployeeResponseDto response =
//                map(employee);

//        DepartmentDto department =
//                restTemplate.getForObject(
//                        "http://localhost:8083/departments/"
//                                + employee.getDepartmentId(),
//                        DepartmentDto.class);
        
//        List<De>
//
//        response.setDepartment(department);

        return response;
    }
    
    //FallBackMethod should have same return type as the original method.
    public EmployeeResponseDto departmentFallback(
            Long id,
            Exception ex) {

        Employee employee =
                repository.findById(id)
                        .orElseThrow(() ->
                                new ResourceNotFoundException(
                                        "Employee not found"));

        EmployeeResponseDto response =
                map(employee);

        DepartmentDto department =
                new DepartmentDto();

        department.setId(0L);
        department.setName(
                "Department Service Unavailable");

        response.setDepartments(
                List.of(department));

        return response;
    }
    public String deleteEmployee(Long id) {
    	Employee employee =
                repository.findById(id)
                        .orElseThrow(() ->
                                new ResourceNotFoundException(
                                        "Employee not found"));
    	repository.delete(employee);
    	return "Deleted";
    }
    
    public List<EmployeeResponseDto> getEmployeeByDeptId(Long id){
    	List<Employee> e = repository.getEmployeeByDepartmentId(id);
    	List<EmployeeResponseDto> empresp = e.stream()
    			.map(emp->getEmployeeById(emp.getId()))
    			.collect(Collectors.toList());
    	return empresp;
    	
    }
    
    

    
    private EmployeeResponseDto map(
            Employee employee) {

        EmployeeResponseDto dto =
                new EmployeeResponseDto();

        dto.setId(employee.getId());
        dto.setName(employee.getName());
        

        return dto;
    }
}


